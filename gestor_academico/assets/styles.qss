/* General Styling */
QWidget {
    font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', sans-serif;
    font-size: 14px;
    color: #333;
    background-color: #ffffff; /* Enforce light theme */
}
#MainWindow { background-color: #f0f2f5; }
QWidget#Surface { background-color: #ffffff; border-radius: 12px; border: 1px solid #e0e0e0; }

/* Sidebar */
#Sidebar { border-right: 1px solid #e0e0e0; }
#Sidebar QPushButton { border: none; padding: 12px 20px; text-align: left; font-size: 16px; font-weight: 500; color: #555; border-radius: 8px; margin: 4px 10px; }
#Sidebar QPushButton:hover { background-color: #eef5ff; }
#Sidebar QPushButton:checked { background-color: #e2ecf8; color: #005fbe; font-weight: 600; }

/* Headers */
QLabel#HeaderTitle { font-size: 28px; font-weight: 600; color: #1c1c1e; }

/* Buttons */
QPushButton#PrimaryButton { background-color: #007aff; color: white; border: none; padding: 10px 20px; font-size: 15px; font-weight: 500; border-radius: 8px; }
QPushButton#PrimaryButton:hover { background-color: #005fbe; }

/* Group Card */
QFrame#GroupCard { border-radius: 12px; border: 1px solid #e0e0e0; min-width: 250px; max-width: 250px; }
QLabel#CardImage { background-color: #e0e0e0; border-top-left-radius: 12px; border-top-right-radius: 12px; min-height: 120px; }
QLabel#CardTitle { font-size: 18px; font-weight: 600; }
QLabel#CardSubtitle { color: #666; font-size: 14px; }
QProgressBar { border: none; background-color: #e0e0e0; border-radius: 4px; height: 8px; text-align: center; }
QProgressBar::chunk { background-color: #ffc107; border-radius: 4px; }

/* Calendar */
QCalendarWidget QToolButton { color: #333; font-size: 14px; icon-size: 18px; background-color: transparent; border: none; border-radius: 8px; padding: 8px; }
QCalendarWidget QToolButton:hover { background-color: #eef5ff; }
QCalendarWidget QAbstractItemView:item:selected { background-color: #007aff; color: white; border-radius: 16px; }

/* Table */
QTableWidget { border: none; gridline-color: #e5e7eb; }
QHeaderView::section { background-color: #f9fafb; padding: 8px; border: none; border-bottom: 1px solid #e5e7eb; font-weight: 600; }
QTableWidget::item { padding: 10px; border-bottom: 1px solid #e5e7eb; }
QTableWidget::item:selected {
    background-color: #eef5ff;
}

QTableWidget::item:focus {
    outline: none;
    border: 1px solid #007aff;
}

/* Remove focus rectangle from combo boxes */
QComboBox:focus {
    outline: none;
    border: 1px solid #007aff;
}
